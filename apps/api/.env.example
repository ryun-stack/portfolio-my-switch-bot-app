PORT=3000
TABLE_STORAGE_CONNECTION_STRING=your-connectionString
QUEUE_STORAGE_CONNECTION_STRING=your-connectionString
CORS_ORIGINS=http://localhost:5173

# Table Storage table names (optional; default to the values below).
STATUS_TABLE_NAME=
USER_TABLE_NAME=
APPLICATION_TABLE_NAME=

# Queue Storage queue names (optional; default to the values below).
SWITCH_QUEUE_NAME=

# Entra ID (ADR.md 3.3/3.5, Phase 2). See Azure Portal app registration for
# the API (Expose an API blade) for these values.
ENTRA_TENANT_ID=
# Expected `aud` claim: the API app registration's Application ID URI or
# client id, depending on how the SPA requests the access token's scope.
ENTRA_API_AUDIENCE=

# Edge device (Raspberry Pi, ADR.md 3.3/4章) authenticates via OAuth2 client
# credentials (app registration + client secret), not a delegated/user
# token. Unlike family members (Users table), the edge app registration's
# Application (client) ID is NOT configured via an env var here — it's
# registered as a row in the Applications table (APPLICATION_TABLE_NAME
# above), the same way family members are registered in the Users table.
# EdgeClientAuthGuard looks up the token's `appid`/`azp` claim in that
# table, so new caller applications can be authorized without a redeploy.
